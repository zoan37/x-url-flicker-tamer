{
  "manifest_version": 3,
  "name": "URL Flicker Tamer for X",
  "version": "1.0.2",
  "description": "Stops the address bar flickering between a post URL and x.com while the page loads. Runs only on x.com; collects no data.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["tamer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
